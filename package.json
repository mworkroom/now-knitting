{
  "name": "now-knitting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --port 8787",
    "dev:demo": "vite --mode demo --host 127.0.0.1",
    "build": "wrangler types && tsc --noEmit && vite build",
    "test": "vitest run",
    "types": "wrangler types",
    "check": "npm run build && npm test && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy --keep-vars"
  },
  "dependencies": {
    "lucide-react": "1.51.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vitest": "latest",
    "wrangler": "^4.145.0"
  }
}
